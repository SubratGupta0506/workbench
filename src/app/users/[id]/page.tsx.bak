// src/app/users/[id]/page.tsx
"use client"

import * as React from "react"
import Link from "next/link"
import { User, Role } from "@/src/lib/types"
import { PERMISSIONS_MATRIX } from "@/src/lib/mockData"
import Sidebar from "@/src/components/layout/Sidebar"
import Topbar from "@/src/components/layout/Topbar"
import RoleBadge from "@/src/components/users/RoleBadge"
import { Toaster } from "@/components/ui/sonner"
import { toast } from "sonner"
import {
  Table,
  TableHeader,
  TableBody,
  TableRow,
  TableCell,
  TableHead,
} from "@/components/ui/table"
import { ArrowLeft, CheckCircle2, XCircle, Loader2 } from "lucide-react"

interface UserDetailPageProps {
  params: Promise<{ id: string }>
}

interface EffectivePermissionsPayload {
  user: User
  roles: Role[]
  permissions: string[]
  permissionGrants: Record<string, string[]>
}

export default function UserDetailPage({ params }: UserDetailPageProps) {
  const resolvedParams = React.use(params)
  const userId = resolvedParams.id

  const [data, setData] = React.useState<EffectivePermissionsPayload | null>(null)
  const [loading, setLoading] = React.useState(true)

  // Fetch effective permissions & user profile details
  const fetchPermissions = async () => {
    try {
      setLoading(true)
      const res = await fetch(`/api/users/${userId}/permissions`)
      if (!res.ok) throw new Error("Failed to load user permissions data")

      const payload = await res.json()
      setData(payload)
    } catch (err) {
      toast.error("Error loading user profile details")
    } finally {
      setLoading(false)
    }
  }

  React.useEffect(() => {
    fetchPermissions()
  }, [userId])

  // Remove role handler calling API
  const handleRemoveRole = async (roleId: string, roleName: string) => {
    if (!data) return
    try {
      const res = await fetch(`/api/users/${userId}/roles?roleId=${roleId}`, {
        method: "DELETE",
      })

      if (!res.ok) throw new Error("Removal failed")

      toast.success(`Removed role "${roleName}" from ${data.user.name}`)
      fetchPermissions() // Re-fetch permissions payload to update union matrix
    } catch (err) {
      toast.error(`Failed to remove role: ${roleName}`)
    }
  }

  if (loading) {
    return (
      <div className="flex h-screen bg-gray-50 overflow-hidden font-sans">
        <Sidebar />
        <div className="flex flex-col flex-1 overflow-hidden">
          <Topbar />
          <main className="flex-1 p-8 flex items-center justify-center">
            <Loader2 className="animate-spin text-indigo-600" size={24} />
            <span className="text-xs text-gray-500 font-semibold ml-2">Resolving user permissions...</span>
          </main>
        </div>
      </div>
    )
  }

  if (!data || !data.user) {
    return (
      <div className="flex h-screen bg-gray-50 overflow-hidden font-sans">
        <Sidebar />
        <div className="flex flex-col flex-1 overflow-hidden">
          <Topbar />
          <main className="flex-1 p-8 flex flex-col items-center justify-center space-y-4">
            <h2 className="text-sm font-bold text-gray-900">User not found</h2>
            <Link href="/users" className="text-xs text-indigo-600 font-semibold flex items-center gap-1">
              <ArrowLeft size={14} /> Back to Users
            </Link>
          </main>
        </div>
      </div>
    )
  }

  const { user, roles: assignedRoles, permissionGrants: permissionGrantsMap } = data

  // Columns: View | Create | Edit | Delete | Special Action
  const columns = [
    { label: "View", getAction: (res: string) => "view" },
    {
      label: "Create",
      getAction: (res: string) => (res === "Members" ? "invite" : "create"),
    },
    {
      label: "Edit",
      getAction: (res: string) =>
        res === "Members" ? "update_role" : res === "Billing" || res === "Settings" ? "update" : "edit",
    },
    {
      label: "Delete",
      getAction: (res: string) => (res === "Members" ? "remove" : "delete"),
    },
    {
      label: "Special Action",
      getAction: (res: string) =>
        res === "Projects"
          ? "archive"
          : res === "Tasks"
          ? "assign"
          : res === "Billing"
          ? "download_invoices"
          : null,
    },
  ]

  return (
    <div className="flex h-screen bg-gray-50 overflow-hidden font-sans">
      <Toaster position="top-right" />

      {/* Navigation Sidebar */}
      <Sidebar />

      {/* Main Content Area */}
      <div className="flex flex-col flex-1 overflow-hidden">
        {/* Topbar Panel */}
        <Topbar />

        {/* Scrollable details view */}
        <main className="flex-1 overflow-y-auto p-8 space-y-8">
          {/* Back Nav Link */}
          <Link
            href="/users"
            className="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500 hover:text-gray-900 transition-colors"
          >
            <ArrowLeft size={14} />
            Back to Users
          </Link>

          {/* User Profile Header Card */}
          <div className="bg-white border border-gray-200 rounded-xl p-6 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div className="flex items-center gap-4">
              <div className="w-14 h-14 bg-indigo-50 text-indigo-700 font-bold text-xl rounded-full flex items-center justify-center border border-indigo-100">
                {user.avatar}
              </div>
              <div className="space-y-1">
                <h1 className="text-xl font-bold text-gray-900 tracking-tight leading-none">
                  {user.name}
                </h1>
                <p className="text-xs text-gray-400 font-medium">{user.email}</p>
              </div>
            </div>

            <div className="space-y-2 max-w-md w-full md:w-auto">
              <span className="text-[10px] font-bold text-gray-400 uppercase tracking-wider block">
                Assigned Roles
              </span>
              <div className="flex flex-wrap gap-1.5">
                {assignedRoles.length > 0 ? (
                  assignedRoles.map((role) => (
                    <RoleBadge
                      key={role.id}
                      roleName={role.name}
                      onRemove={() => handleRemoveRole(role.id, role.name)}
                    />
                  ))
                ) : (
                  <span className="text-xs text-gray-400 italic font-medium">
                    No roles assigned
                  </span>
                )}
              </div>
            </div>
          </div>

          {/* Effective Permissions Matrix Card */}
          <div className="space-y-4">
            <div className="space-y-1">
              <h2 className="text-sm font-bold text-gray-900">Effective Permissions</h2>
              <p className="text-xs text-gray-500 font-medium">
                Below are the union-merged permissions of {user.name} derived from their assigned roles.
              </p>
            </div>

            <div className="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
              <Table>
                <TableHeader className="bg-gray-50 border-b border-gray-200">
                  <TableRow className="hover:bg-transparent">
                    <TableHead className="text-[11px] font-bold text-gray-500 uppercase tracking-wider px-6 py-3.5 w-1/5">
                      Resource
                    </TableHead>
                    {columns.map((col) => (
                      <TableHead
                        key={col.label}
                        className="text-[11px] font-bold text-gray-500 uppercase tracking-wider px-4 py-3.5 text-center"
                      >
                        {col.label}
                      </TableHead>
                    ))}
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {PERMISSIONS_MATRIX.map((resourceGroup) => {
                    const resourceName = resourceGroup.resource
                    const resourceKey = resourceName.toLowerCase()

                    return (
                      <TableRow
                        key={resourceName}
                        className="border-b border-gray-150 hover:bg-gray-50/50 transition-colors"
                      >
                        {/* Resource Name column */}
                        <TableCell className="px-6 py-4 font-bold text-gray-900 text-xs w-1/5">
                          {resourceName}
                        </TableCell>

                        {/* Action cells */}
                        {columns.map((col) => {
                          const action = col.getAction(resourceName)
                          
                          // If action doesn't exist for this resource
                          if (!action) {
                            return (
                              <TableCell key={col.label} className="px-4 py-4 text-center text-gray-300 select-none">
                                &mdash;
                              </TableCell>
                            )
                          }

                          const permissionKey = `${resourceKey}.${action}`
                          const grantingRoles = permissionGrantsMap[permissionKey] || []
                          const isGranted = grantingRoles.length > 0

                          // Format action name nicely (e.g. "download_invoices" -> "Download Invoices")
                          const actionLabel = action
                            .split("_")
                            .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
                            .join(" ")

                          return (
                            <TableCell key={col.label} className="px-4 py-3.5 text-center">
                              <div className="flex flex-col items-center justify-center space-y-1">
                                {isGranted ? (
                                  <>
                                    <CheckCircle2 size={16} className="text-emerald-500" />
                                    <span className="text-[9px] text-gray-800 font-semibold leading-tight">
                                      {actionLabel}
                                    </span>
                                    <span
                                      className="text-[8px] text-indigo-500 font-medium leading-none max-w-[90px] truncate"
                                      title={`Granted by: ${grantingRoles.join(", ")}`}
                                    >
                                      via {grantingRoles[0]}
                                      {grantingRoles.length > 1 && ` (+${grantingRoles.length - 1})`}
                                    </span>
                                  </>
                                ) : (
                                  <>
                                    <XCircle size={16} className="text-gray-300" />
                                    <span className="text-[9px] text-gray-400 font-medium leading-tight">
                                      {actionLabel}
                                    </span>
                                  </>
                                )}
                              </div>
                            </TableCell>
                          )
                        })}
                      </TableRow>
                    )
                  })}
                </TableBody>
              </Table>
            </div>
          </div>
        </main>
      </div>
    </div>
  )
}
